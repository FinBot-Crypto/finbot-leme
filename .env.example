# Leme possui configuração própria e não recebe as chaves de execução do Core.
DB_USER=finbot_leme
DB_PASSWORD=change-me-leme
DB_NAME=crypto_bot
NATS_URL=nats://crypto-nats:4222
BINANCE_API_KEY=
BINANCE_API_SECRET=
DRY_RUN=true
LEME_LIVE_ORDERS_ENABLED=false
LEME_PAPER_SPOT_BALANCE=10000
LEME_PAPER_FUTURES_BALANCE=10000
TZ=America/Sao_Paulo
UPDATE_INTERVAL=900
MAX_POSITIONS=20
ML_MODELS_VOLUME=crypto_ml_models
# Optional migration accelerator when the legacy images already exist on the host.
# Leave empty on a fresh host to build from python:3.12-slim.
LEME_ENGINE_BASE_IMAGE=python:3.12-slim
LEME_SHADOW_BASE_IMAGE=python:3.12-slim
